# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/synapse

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_AI_PER_MINUTE=10

# LLM Provider Configuration
# Supported providers: nim, groq, gemini
LLM_PROVIDER=nim

# NVIDIA NIM Configuration
NVIDIA_API_KEY=
NIM_MODEL=

# Groq Configuration
GROQ_API_KEY=
GROQ_MODEL=

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=

# Common LLM Settings
LLM_TIMEOUT_SECONDS=30
LLM_GENERATION_CONCURRENCY=3

# AI Worker & Job Queue Configuration
AI_WORKER_CONCURRENCY=4
AI_JOB_MAX_ATTEMPTS=3
AI_JOB_STALE_AFTER_SECONDS=300
