{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Diagnosis",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "attemptId", "studentId", "conceptId", "errorType", "summary", "confidence", "createdAt"],
  "properties": {
    "id": { "type": "string" },
    "attemptId": { "type": "string" },
    "studentId": { "type": "string" },
    "conceptId": { "type": "string" },
    "errorType": { "enum": ["misconception", "missing_prerequisite", "careless", "unknown"] },
    "summary": { "type": "string" },
    "suspectedMisconception": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
