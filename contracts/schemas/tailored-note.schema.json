{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TailoredNote",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "studentId", "conceptId", "version", "markdown", "linkedConceptIds", "basedOnDiagnosisIds", "updatedAt"],
  "properties": {
    "id": { "type": "string" },
    "studentId": { "type": "string" },
    "conceptId": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "markdown": { "type": "string" },
    "linkedConceptIds": { "type": "array", "items": { "type": "string" } },
    "basedOnDiagnosisIds": { "type": "array", "items": { "type": "string" } },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
